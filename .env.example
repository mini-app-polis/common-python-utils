# Names only: the values live in Doppler (mini-app-polis-ecosystem / dev).
# Run under `doppler run -- …`; do not copy this file to .env — nothing reads it.
# Uncommented names are required in dev; commented ones are optional.
# `uv run check-doppler-keys` lists any required name dev is missing.

# KaianoApiClient
KAIANO_API_BASE_URL=https://deejay-marvel-api.up.railway.app
# This caller's own named API key. The client derives the variable name
# from machine_name (deejay-cog -> DEEJAY_COG_API_KEY); KAIANO_API_KEY is
# the fallback for a caller that declares no name.
# KAIANO_API_KEY=

# Logging
# LOGGING_LEVEL=INFO

# Google APIs
GOOGLE_CREDENTIALS_JSON=

# Spotify
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REFRESH_TOKEN=

# LLM (optional extra)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Discord (mini_app_polis.discord / activity). Each channel falls back to
# DISCORD_WEBHOOK_URL when its own variable is unset.
# DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_DEFAULT=
DISCORD_WEBHOOK_URL_ERRORS=
DISCORD_WEBHOOK_URL_ACTIVITY=
DISCORD_WEBHOOK_URL_RUNS=
