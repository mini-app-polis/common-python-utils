# miniapppolis-common-utils — the names the library reads. Names only: the
# values live in Doppler (common-python-utils / dev). Run under
# `doppler run -- …`; do not copy this file to .env — nothing reads it.
# Uncommented names are required in dev; commented ones are optional: the
# code has a default, only production reads them, the platform sets them,
# or only the module that needs them reads them.
# `uv run check-doppler-keys` lists any required name dev is missing.

# ── environment ──────────────────────────────────────────────────────────
# Which environment this process is in: ENVIRONMENT first, then Railway's
# own names. Unset, the process is local. Doppler sets ENVIRONMENT per
# config (development in dev).
# ENVIRONMENT=
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_ENVIRONMENT=
# Per-effect overrides (effect_enabled): true or false forces an outbound
# effect on or off in any environment; unset, production enables it and
# every other environment suppresses it.
# HEALTHCHECKS_ENABLED=
# CLOUDWATCH_METRICS_ENABLED=
# ASANA_ENABLED=

# ── KaianoApiClient ──────────────────────────────────────────────────────
# Production reads KAIANO_API_BASE_URL; every other environment reads
# KAIANO_API_BASE_URL_DEV, with no fallback between them.
KAIANO_API_BASE_URL_DEV=
# KAIANO_API_BASE_URL=
# The caller's own named key is <MACHINE_NAME>_API_KEY, derived from the
# machine name by machine_key_env_var() (deejay-cog -> DEEJAY_COG_API_KEY);
# each caller lists its own. KAIANO_API_KEY is the fallback for a caller
# that declares no name; KAIANO_API_MACHINE_NAME names the machine when the
# caller passes none.
# KAIANO_API_KEY=
# KAIANO_API_MACHINE_NAME=

# ── logger and Sentry ────────────────────────────────────────────────────
# Log level (default INFO), and the format: json or text; unset, JSON on
# Railway (detected by RAILWAY_PROJECT_ID or the Railway environment
# names above) and text elsewhere.
# LOGGING_LEVEL=
# LOG_FORMAT=
# RAILWAY_PROJECT_ID=
# The Sentry DSN init_sentry reads unless the caller names another variable.
# SENTRY_DSN_COGS=

# ── Lambda workers ───────────────────────────────────────────────────────
# Set on the function, never in Doppler: the SSM prefix and the required
# and optional parameter maps load_secrets reads, and the memory size
# timing reports.
# SSM_PREFIX=
# SSM_PARAMETERS=
# SSM_OPTIONAL_PARAMETERS=
# AWS_LAMBDA_FUNCTION_MEMORY_SIZE=

# ── Google ───────────────────────────────────────────────────────────────
# Service-account JSON for Drive and Sheets (GoogleAPI); without it the
# client looks for credentials.json.
GOOGLE_CREDENTIALS_JSON=
# config: the VirtualDJ history folder, and the timezone (default UTC).
# VDJ_HISTORY_FOLDER_ID=
# TIMEZONE=

# ── Spotify ──────────────────────────────────────────────────────────────
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REFRESH_TOKEN=
# The OAuth redirect URI, and the playlist trim/add use when given none.
# SPOTIPY_REDIRECT_URI=
# SPOTIFY_PLAYLIST_ID=

# ── LLM (llm extra) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Discord (discord, activity) ──────────────────────────────────────────
# One webhook per channel; each falls back to DISCORD_WEBHOOK_URL when its
# own variable is unset.
# DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_DEFAULT=
DISCORD_WEBHOOK_URL_ERRORS=
DISCORD_WEBHOOK_URL_ACTIVITY=
DISCORD_WEBHOOK_URL_RUNS=

# ── Asana (AsanaClient) ──────────────────────────────────────────────────
# Personal access token, read per request so rotation needs no restart, and
# the workspace gid, needed only by find_or_create_tag().
# ASANA_ACCESS_TOKEN=
# ASANA_WORKSPACE_ID=

# ── Doppler (DopplerClient.from_env) ─────────────────────────────────────
# Writing a secret back to Doppler from a service: a service token with
# write access to that one config; Doppler's syncs inject the other two.
# DOPPLER_TOKEN=
# DOPPLER_PROJECT=
# DOPPLER_CONFIG=

# ── Prefect (legacy) ─────────────────────────────────────────────────────
# The run id pipeline_status falls back to under Prefect.
# PREFECT_FLOW_RUN_ID=
